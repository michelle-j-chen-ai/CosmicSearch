# syntax=docker/dockerfile:1
# GPU (NVIDIA L4) variant of the nls_search_app image. Identical to Dockerfile
# except it installs CUDA torch wheels so gpu_corpus's `cuda` path can hold the
# int8 corpus in L4 VRAM (24GB) and score on-GPU -- sidestepping the 32GiB CPU
# RAM ceiling that OOM-kills the CPU build on the 47.8M-row corpus.
# Deploy target: Cloud Run GPU in a GPU region (us-central1) with NLS_DEVICE=cuda.
# `deps` = Python + CUDA torch + requirements.lock (CI-safe; no gitignored adp).
FROM python:3.13-slim AS deps
COPY --from=ghcr.io/astral-sh/uv:0.11.21 /uv /uvx /bin/

WORKDIR /app

ENV UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1

# CUDA torch stack (cu126 wheels bundle the CUDA runtime; the Cloud Run GPU host
# provides the driver). torchvision is required by the Cosmos-Embed remote code.
RUN uv pip install \
      --index-url https://download.pytorch.org/whl/cu126 \
      torch==2.8.0 torchvision==0.23.0

COPY requirements.lock .
RUN uv pip install -r requirements.lock

FROM deps AS runtime
# Vendored DORA SDK proto stubs (see Dockerfile for why adp/ is local).
COPY adp/ ./adp/

COPY config.py oci_s3.py local_cache.py search_engine.py analytics.py app.py ./
COPY gpu_corpus.py ./
COPY web_server.py dora_client.py db.py machine_auth.py ./
COPY web ./web

ENV HF_HOME=/tmp/hf_cache
ENV PORT=8080
EXPOSE 8080

COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh
CMD ["./entrypoint.sh"]
